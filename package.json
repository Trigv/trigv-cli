{
  "name": "@trigv/cli",
  "version": "0.2.0",
  "description": "Official Trigv CLI — send notification events from the shell",
  "type": "module",
  "bin": {
    "trigv": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/bin.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --check src test",
    "format:write": "prettier --write src test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "trigv",
    "notifications",
    "push",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Trigv/trigv-cli.git"
  },
  "homepage": "https://github.com/Trigv/trigv-cli#readme",
  "bugs": {
    "url": "https://github.com/Trigv/trigv-cli/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
